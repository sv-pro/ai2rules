{
  "manifest_version": 3,
  "name": "ai2rules WebMCP governor (spike)",
  "version": "0.0.1",
  "description": "The ai2rules kernel, in WebAssembly, decides every WebMCP tool call before the page's handler runs. Spike: demo pages on 127.0.0.1 only.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open the ai2rules side panel" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
