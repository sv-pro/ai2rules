# Copy to `.env` in this directory and fill in what you need. `.env` is
# gitignored; this template is committed and holds names only, never values.
# A variable already set in your shell wins over the file.

# Required only for the LLMAgent column (`node src/run.js --agent llm --matrix`).
# Create one at https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# Optional. Model for the LLMAgent column (default: claude-sonnet-5-5).
WEBMCP_LLM_MODEL=

# Optional. Reasoning effort for the LLMAgent column (default: the model's own).
WEBMCP_LLM_EFFORT=

# Optional. First of four consecutive ports for the lab's origins (default: 4100).
# Use a different base per checkout when several run at once.
WEBMCP_BASE_PORT=

# Optional. Path to the `harness` binary D2 calls. Default: target/release, then
# target/debug of this repository, then PATH.
HARNESS_BIN=
